# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Build Outputs ────────────────────────────────────────────────────────────
dist
.output
tmp
out-tsc
*.tsbuildinfo
build/

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
.dev.vars

# ─── Platform-specific Cache & Config ─────────────────────────────────────────
.cache/
.local/
.wrangler/
.tanstack/
.migration-backup/
.expo
.expo-shared

# ─── Replit ───────────────────────────────────────────────────────────────────
.replit
.replitignore

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── System Files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-error.log
*.log

# ─── Package locks (keep only pnpm) ──────────────────────────────────────────
package-lock.json
yarn.lock

# ─── Miscellaneous ────────────────────────────────────────────────────────────
/.sass-cache
/connect.lock
/coverage
/typings
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
